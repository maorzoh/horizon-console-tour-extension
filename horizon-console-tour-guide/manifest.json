{
  "manifest_version": 3,
  "name": "Horizon Console Tour Guide",
  "version": "0.1.0",
  "description": "Hover any menu item or setting in the Horizon admin console to see what it does.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Horizon Console Tour Guide: turn hover explanations on or off",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/admin/*"
      ],
      "js": [
        "tour-data.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
